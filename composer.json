{
    "name": "happones/kinetix",
    "description": "A modern Vue 3 and Inertia.js dashboard and admin toolkit for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "happones",
            "email": "happones@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "spatie/laravel-typescript-transformer": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Happones\\Kinetix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happones\\Kinetix\\KinetixServiceProvider"
            ]
        }
    }
}
