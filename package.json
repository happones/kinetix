{
    "name": "happones-kinetix",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prelint": "rm -f vendor/orchestra/testbench-core/laravel/vendor",
        "lint": "eslint resources/js eslint.config.js --fix",
        "prelint:check": "rm -f vendor/orchestra/testbench-core/laravel/vendor",
        "lint:check": "eslint resources/js eslint.config.js",
        "format": "prettier --write resources/js gallery tests/js",
        "format:check": "prettier --check resources/js gallery tests/js",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "gallery:dev": "vite --config vite.gallery.config.ts",
        "screenshots:messages": "php scripts/gen-gallery-messages.php",
        "screenshots": "npm run screenshots:messages && node scripts/screenshots.mjs",
        "types:check": "vue-tsc --noEmit",
        "prepare": "husky",
        "test:e2e": "node scripts/e2e-relation-managers.mjs"
    },
    "lint-staged": {
        "*.php": "vendor/bin/pint",
        "{resources/js/**/*.{js,ts,vue},eslint.config.js}": "eslint --fix",
        "{resources/js,gallery,tests/js}/**/*": "prettier --write --ignore-unknown"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^9.19.0",
        "@inertiajs/vue3": "^3.0.0",
        "@internationalized/date": "^3.12.2",
        "@laravel/echo-vue": "^2.3.0",
        "@lucide/vue": "^1.17.0",
        "@stripe/stripe-js": "^9.9.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.1",
        "@tanstack/vue-table": "^8.21.3",
        "@tanstack/vue-virtual": "^3.13.29",
        "@tiptap/core": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "@types/node": "^22.13.5",
        "@unovis/ts": "^1.3.0",
        "@unovis/vue": "^1.3.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.11",
        "driver.js": "^1.8.0",
        "esbuild": "^0.25.12",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "happy-dom": "^20.10.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "mermaid": "^11.15.0",
        "pinia": "^2.3.1",
        "playwright": "^1.61.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "reka-ui": "^2.10.0",
        "simple-icons": "^16.24.0",
        "tailwindcss": "^4.3.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17",
        "vitest": "^4.1.0",
        "vue": "^3.5.13",
        "vue-i18n": "^11.0.0",
        "vue-sonner": "^2.0.0",
        "vue-tsc": "^2.2.4"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@internationalized/date": "^3.0.0",
        "@laravel/echo-vue": "^2.3.0",
        "@lucide/vue": "^1.0.0",
        "@stripe/stripe-js": "^4.0.0 || ^9.0.0",
        "@tanstack/vue-table": "^8.0.0",
        "@tanstack/vue-virtual": "^3.0.0",
        "@unovis/ts": "^1.3.0",
        "@unovis/vue": "^1.3.0",
        "driver.js": "^1.3.0",
        "pinia": "^2.3.1",
        "reka-ui": "^2.0.0",
        "vue": "^3.5.0",
        "vue-i18n": "^11.0.0",
        "vue-sonner": "^2.0.0"
    },
    "peerDependenciesMeta": {
        "reka-ui": {
            "optional": true
        },
        "@tanstack/vue-table": {
            "optional": true
        },
        "@internationalized/date": {
            "optional": true
        },
        "@stripe/stripe-js": {
            "optional": true
        }
    },
    "overrides": {
        "esbuild": "$esbuild",
        "vite": "$vite"
    }
}
