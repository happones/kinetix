# Normalize line endings so a Windows checkout can't produce a dirty tree.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.wav binary

# Keep development-only files out of the Packagist dist archive. A consumer
# needs src/, config/, database/, resources/ and the metadata files — not the
# 290-file docs site, the test suite, or the screenshot gallery.
/.agents            export-ignore
/.editorconfig      export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.prettierignore    export-ignore
/.prettierrc        export-ignore
/art                export-ignore
/docs               export-ignore
/gallery            export-ignore
/relationship       export-ignore
/storage            export-ignore
/tests              export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/ROADMAP.md         export-ignore
/composer.lock      export-ignore
/eslint.config.js   export-ignore
/package-lock.json  export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/tsconfig.json      export-ignore
/vite.gallery.config.ts export-ignore
/vitest.config.ts   export-ignore
